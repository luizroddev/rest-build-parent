<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.restship</groupId>
    <artifactId>rest-build-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Minerest Build Parent</name>
    <description>Parent POM for the Minerest server network modules and plugins.</description>

    <modules>
        <module>rest-bom</module>
    </modules>

    <!-- ================================================================== -->
    <!-- Properties                                                         -->
    <!-- ================================================================== -->
    <properties>
        <!-- Java version: 22 by default.
             Override in child POMs that need Java 17:
               <java.version>17</java.version>
        -->
        <java.version>22</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- GitHub Packages coordinates: override in child POMs if needed -->
        <github.owner>luizroddev</github.owner>
        <github.repo>rest-build-parent</github.repo>

        <!-- ============================================================ -->
        <!-- Dependency versions (used by rest-bom)                       -->
        <!-- ============================================================ -->

        <!-- Restship internal modules -->
        <restserver.version>1.0.4</restserver.version>
        <logger.version>0.0.2-SNAPSHOT</logger.version>
        <concurrency.version>0.0.2</concurrency.version>
        <network.version>1.0.37-SNAPSHOT</network.version>
        <minecore.version>0.1.77-SNAPSHOT</minecore.version>
        <pvpgame.version>1.0-SNAPSHOT</pvpgame.version>

        <!-- Database -->
        <jooq.version>3.19.6</jooq.version>
        <hikaricp.version>5.1.0</hikaricp.version>
        <hibernate.version>6.4.4.Final</hibernate.version>
        <postgresql.version>42.7.2</postgresql.version>
        <mysql-connector.version>8.3.0</mysql-connector.version>
        <mariadb-client.version>2.1.2</mariadb-client.version>
        <resultset-mapper.version>1.6.2</resultset-mapper.version>

        <!-- Serialization / Data -->
        <jackson.version>2.17.0</jackson.version>
        <gson.version>2.10.1</gson.version>

        <!-- Redis -->
        <jedis.version>5.1.0</jedis.version>
        <lettuce.version>6.3.2.RELEASE</lettuce.version>

        <!-- Minecraft APIs -->
        <adventure-platform-bukkit.version>4.3.4</adventure-platform-bukkit.version>
        <adventure-api.version>4.17.0</adventure-api.version>
        <acf-paper.version>0.5.1-SNAPSHOT</acf-paper.version>
        <luckperms.version>5.4</luckperms.version>
        <velocity-api.version>3.4.0-SNAPSHOT</velocity-api.version>

        <!-- Utilities -->
        <lombok.version>1.18.30</lombok.version>
        <reflections.version>0.10.2</reflections.version>
        <antlr4.version>4.13.0</antlr4.version>
        <configurate-hocon.version>3.7</configurate-hocon.version>
        <asciitable.version>0.3.2</asciitable.version>

        <!-- Test -->
        <mockito.version>4.0.0</mockito.version>

        <!-- ============================================================ -->
        <!-- Plugin versions                                              -->
        <!-- ============================================================ -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-deploy-plugin.version>3.1.3</maven-deploy-plugin.version>
        <maven-release-plugin.version>3.1.1</maven-release-plugin.version>
    </properties>

    <!-- ================================================================== -->
    <!-- Repositories (inherited by all children)                           -->
    <!-- ================================================================== -->
    <repositories>
        <repository>
            <id>restship</id>
            <url>https://maven.pkg.github.com/romulofebasi/restship</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>restship-build</id>
            <url>https://maven.pkg.github.com/luizroddev/rest-build-parent</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>restship-pvpgame</id>
            <url>https://maven.pkg.github.com/luizroddev/rest-module-pvpgame</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>aikar</id>
            <url>https://repo.aikar.co/content/groups/aikar/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype-snapshots</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <!-- ================================================================== -->
    <!-- Distribution Management (inherited by all children)                -->
    <!-- Override github.owner / github.repo in child POMs if needed.       -->
    <!-- ================================================================== -->
    <distributionManagement>
        <repository>
            <id>restship</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/${github.owner}/${github.repo}</url>
        </repository>
        <snapshotRepository>
            <id>restship</id>
            <name>GitHub Packages Snapshots</name>
            <url>https://maven.pkg.github.com/${github.owner}/${github.repo}</url>
        </snapshotRepository>
    </distributionManagement>

    <!-- ================================================================== -->
    <!-- Plugin Management                                                  -->
    <!-- ================================================================== -->
    <build>
        <!-- Resource filtering, deliberately scoped to plugin.yml.

             plugin.yml carries a version that must match the POM. Copying it by
             hand is what let every plugin.yml in the network drift: minecore sat
             at 0.0.1 while the POM was at 0.1.76. Deriving it removes the drift
             at the source, in every build rather than only at release time.

             The filtering is scoped to plugin.yml alone because filtering runs a
             text substitution over whatever it touches, and several children ship
             binary resources (rest-plugin-royale has victory_template.png and
             GulagSS.schematic). The second, unfiltered block copies everything
             else verbatim. Both blocks are required: declaring only the first
             would silently stop every other resource from being copied.

             Children that declare their own <resources> override this wholesale
             and must repeat both blocks. None do today. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <pluginManagement>
            <plugins>
                <!-- Compiler: version and source/target only.
                     Child POMs add their own <compilerArgs> (e.g. enable-preview, add-opens). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>

                <!-- Shade -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
                    </configuration>
                </plugin>

                <!-- Source JAR -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Deploy -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>

                <!-- Release -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>${maven-release-plugin.version}</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Plugins active for the parent itself -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
